# {{project.name}} — generated from {{self.name}}@{{self.version}}:greeter
#
# The protobuf/gRPC stubs are NOT checked in. They are generated during the
# build by protoc and grpc_cpp_plugin, which mcpp builds for this machine out of
# the same packages this project links against — so the generator and the
# runtime cannot be different versions. Edit proto/helloworld.proto and build;
# that is the whole workflow.
#
# Under `mcpp build --target <triple>` both tools are still built for the BUILD
# machine, because a code generator has to run here. You do not have to do
# anything for that.
[package]
name        = "{{project.name}}"
version     = "0.1.0"
standard    = "c++23"

[build]
sources = ["src/main.cpp"]

[targets.{{project.name}}]
kind = "bin"
main = "src/main.cpp"

# One dependency, and it is the library you actually use.
#
# `features = ["codegen"]` is what pulls in protoc, the gRPC C++ plugin and the
# `grpcgen` rule that drives them — which tools gRPC codegen needs is the gRPC
# package's knowledge, not yours. The `grpc` namespace, because this is
# UPSTREAM gRPC code: a namespace names whose library it is, not who packaged
# it.
[dependencies.grpc]
{{self.name}} = { version = "{{self.version}}", features = ["codegen"] }
